# Database/authentication: required for deployment and persistent local data.
# Use Atlas or a replica set; inquiry completion uses MongoDB transactions.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000

# Optional server-side Gemini provider. Never use a VITE_ prefix for secrets.
# One key enables natural tool planning, cloud transcription and dynamic translation.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
STT_PROVIDER=gemini
STT_MODEL=gemini-2.5-flash

# Natural spoken replies; uses GEMINI_API_KEY unless a separate key is supplied.
# Without keys, installed browser voices and local eSpeak remain available.
TTS_PROVIDER=gemini
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
TTS_API_KEY=

# Optional separate Gemini keys for language understanding and transcription.
LLM_API_KEY=
STT_API_KEY=

# Without provider keys the app uses local intent parsing + multilingual Whisper.
# Set LLM_PROVIDER=local / STT_PROVIDER=local to force the local providers.
WHISPER_MODEL=Xenova/whisper-small

# Optional one-time administrator provisioning with npm run admin:create.
# Existing administrator accounts remain valid. No account is auto-seeded.
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Store Administrator
